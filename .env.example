# Copy to .env to override any of these. All settings are optional; the defaults
# below are what the application uses out of the box.

# --- Acquiring bank ---
GATEWAY_ACQUIRING_BANK_URL=http://localhost:8080
GATEWAY_BANK_CONNECT_TIMEOUT_SECONDS=2.0
GATEWAY_BANK_READ_TIMEOUT_SECONDS=10.0
GATEWAY_BANK_MAX_ATTEMPTS=3
GATEWAY_BANK_RETRY_BACKOFF_SECONDS=0.2

# --- Payment rules ---
GATEWAY_SUPPORTED_CURRENCIES=["GBP","USD","EUR"]
GATEWAY_MAX_AMOUNT_MINOR_UNITS=100000000000

# --- Merchant API keys (key -> merchant id) ---
# Test values only. Real deployments would store hashed keys in the datastore.
GATEWAY_API_KEYS={"sk_test_alpha":"merchant_alpha","sk_test_beta":"merchant_beta"}

# --- Logging ---
GATEWAY_LOG_LEVEL=INFO
GATEWAY_JSON_LOGS=true
